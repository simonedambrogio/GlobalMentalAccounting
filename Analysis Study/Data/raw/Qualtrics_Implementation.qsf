ll,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"psicologiapd","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*2014","overrides":{"logo":{"url":"https:\/\/psicologiapd.fra1.qualtrics.com\/CP\/Graphic.php?IM=IM_0D1UROgBJJVw9kV"},"colors":{"primary":"#b11613"}}},"NewScoring":1,"EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":false,"AutoConfirmStart":false,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.co\/submissions\/complete?cc=62226F4F","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"ProtectSelectionIds":true,"SurveyCreationDate":"2022-06-30 10:23:59","CustomLanguages":[]}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Dear Participant, We invite you to take part in an online study with the purpose of investigating...","TertiaryAttribute":null,"Payload":{"QuestionText":"Dear Participant,<br \/>\n<br \/>\nWe invite you to take part in an online study with the purpose of investigating how people make decisions. The duration of the questionnaire is approximately 10 minutes. At the end of the questionnaire, you will be asked some personal demographic information.<br \/>\n<br \/>\nYour data will be analyzed anonymously and processed according to the current international legislation for the protection of privacy (D. Lgs 196\/2003 and EU GDPR 679\/2016 on the protection of personal data and art. 9 of the Deontological Code of Italian Psychologists). Your data will be used solely for the purposes of the research itself. No information regarding you personally will be published or revealed in any way.<br \/>\n<br \/>\nYou are free to withdraw from the study at any point without giving any explanation. In this case your data will be deleted. You will not receive any payment or reimbursement of any sort for your participation in this study. There are no known risks associated with participating in this study.<br \/>\n<br \/>\nProject Manager: Enrico Rubaltelli (Department of Development Psychology and Socialization -DPSS, University of Padua). The person responsible for this research agrees to comply with the obligations of current legislation in terms of collection, processing and storage of sensitive data.<br \/>\n<br \/>\nI DECLARE THAT<br \/>\n&bull; I am 18 years old or older<br \/>\n&bull; I take part in this project voluntarily<br \/>\n&bull; I am aware of the objectives and aims of this research project<br \/>\n&bull; I am aware that the data obtained, in absolute anonymity, will be treated exclusively for educational and research purposes<br \/>\n&bull; I am aware that it is not possible to withdraw the data I have provided once it has been submitted.<br \/>\n<br \/>\nFor any clarification you can contact Prof. Enrico Rubaltelli at jdmlab.multicountry@gmail.com.","DefaultChoices":false,"DataExportTag":"Consent","QuestionID":"QID1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dear Participant, We invite you to take part in an online study with the purpose of investigating...","Choices":{"1":{"Display":"I agree to participate in the research"},"2":{"Display":"I do NOT agree to participate in the research"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Dear Participant,<br \/>\n<br \/>\nWe invite you to take part in an online study with the purpose of investigating how people make decisions. The duration of the questionnaire is approximately 10 minutes. At the end of the questionnaire, you will be asked some personal demographic information.<br \/>\n<br \/>\nYour data will be analyzed anonymously and processed according to the current international legislation for the protection of privacy (D. Lgs 196\/2003 and EU GDPR 679\/2016 on the protection of personal data and art. 9 of the Deontological Code of Italian Psychologists). Your data will be used solely for the purposes of the research itself. No information regarding you personally will be published or revealed in any way.<br \/>\n<br \/>\nYou are free to withdraw from the study at any point without giving any explanation. In this case your data will be deleted. You will not receive any payment or reimbursement of any sort for your participation in this study. There are no known risks associated with participating in this study.<br \/>\n<br \/>\nProject Manager: Enrico Rubaltelli (Department of Development Psychology and Socialization -DPSS, University of Padua). The person responsible for this research agrees to comply with the obligations of current legislation in terms of collection, processing and storage of sensitive data.<br \/>\n<br \/>\nI DECLARE THAT<br \/>\n&bull; I am 18 years old or older<br \/>\n&bull; I take part in this project voluntarily<br \/>\n&bull; I am aware of the objectives and aims of this research project<br \/>\n&bull; I am aware that the data obtained, in absolute anonymity, will be treated exclusively for educational and research purposes<br \/>\n&bull; I am aware that it is not possible to withdraw the data I have provided once it has been submitted.<br \/>\n<br \/>\nFor any clarification you can contact Prof. Enrico Rubaltelli at jdmlab.multicountry@gmail.com."}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"\u00a0 Person A bought a lottery ticket and won $100. Also, they damaged one door in their apartment i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>&nbsp;<\/div>\n\n<div>Person A bought a lottery ticket and won <strong>$100<\/strong>. Also, they damaged one door in their apartment in an accident and had to pay the landlord <strong>$80<\/strong>. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Person B bought a lottery ticket and won <strong>$20<\/strong>. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Who is happier?<\/div>","DataExportTag":"MrAB3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 Person A bought a lottery ticket and won $100. Also, they damaged one door in their apartment i...","Choices":{"1":{"Display":"A","InputHeight":29,"InputWidth":60},"2":{"Display":"B"},"3":{"Display":"No difference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<div>&nbsp;<\/div>\n\n<div>Person A bought a lottery ticket and won <strong>$100<\/strong>. Also, they damaged one door in their apartment in an accident and had to pay the landlord <strong>$80<\/strong>. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Person B bought a lottery ticket and won <strong>$20<\/strong>. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Who is happier?<\/div>"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Person A damaged their car in a parking lot. They had to spend $200 to repair the damage. The sam...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Person A damaged their car in a parking lot. They had to spend <strong>$200<\/strong> to repair the damage. The same day they damaged the car they won <strong>$25<\/strong> in a raffle. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Person B damaged their car in a parking lot. They had to spend <strong>$175 <\/strong>to repair the damage. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Who is more upset?\n<div>&nbsp;<\/div>\n<\/div>","DataExportTag":"MrAB4 ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Person A damaged their car in a parking lot. They had to spend $200 to repair the damage. The sam...","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"No difference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID11","QuestionText_Unsafe":"<div>Person A damaged their car in a parking lot. They had to spend <strong>$200<\/strong> to repair the damage. The same day they damaged the car they won <strong>$25<\/strong> in a raffle. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Person B damaged their car in a parking lot. They had to spend <strong>$175 <\/strong>to repair the damage. &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Who is more upset?\n<div>&nbsp;<\/div>\n<\/div>"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID114","SecondaryAttribute":"List of Countries","TertiaryAttribute":null,"Payload":{"QuestionText":"Which country do you currently live in?","QuestionType":"MC","Selector":"DL","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","NumColumns":2,"LabelPosition":"BELOW"},"QuestionDescription":"List of Countries","Choices":{"1":{"Display":"Afghanistan"},"2":{"Display":"Albania"},"3":{"Display":"Algeria"},"4":{"Display":"Andorra"},"5":{"Display":"Angola"},"6":{"Display":"Antigua and Barbuda"},"7":{"Display":"Argentina"},"8":{"Display":"Armenia"},"9":{"Display":"Australia"},"10":{"Display":"Austria"},"11":{"Display":"Azerbaijan"},"12":{"Display":"Bahamas"},"13":{"Display":"Bahrain"},"14":{"Display":"Bangladesh"},"15":{"Display":"Barbados"},"16":{"Display":"Belarus"},"17":{"Display":"Belgium"},"18":{"Display":"Belize"},"19":{"Display":"Benin"},"20":{"Display":"Bhutan"},"21":{"Display":"Bolivia"},"22":{"Display":"Bosnia and Herzegovina"},"23":{"Display":"Botswana"},"24":{"Display":"Brazil"},"25":{"Display":"Brunei Darussalam"},"26":{"Display":"Bulgaria"},"27":{"Display":"Burkina Faso"},"28":{"Display":"Burundi"},"29":{"Display":"Cambodia"},"30":{"Display":"Cameroon"},"31":{"Display":"Canada"},"32":{"Display":"Cape Verde"},"33":{"Display":"Central African Republic"},"34":{"Display":"Chad"},"35":{"Display":"Chile"},"36":{"Display":"China"},"37":{"Display":"Colombia"},"38":{"Display":"Comoros"},"39":{"Display":"Congo, Republic of the..."},"40