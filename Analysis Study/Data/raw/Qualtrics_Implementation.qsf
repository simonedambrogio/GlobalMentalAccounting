splay":"Russian"},"18":{"Display":"Spanish"},"19":{"Display":"Thai"},"20":{"Display":"Turkish"},"21":{"Display":"Vietnamese"},"22":{"Display":"Brazilian Portuguese"},"23":{"Display":"Danish"},"24":{"Display":"Korean"},"25":{"Display":"Swedish"},"26":{"Display":"European Portuguese"},"27":{"Display":"Hebrew"},"29":{"Display":"Other"}},"ChoiceOrder":[1,2,"22",3,"23",4,5,"26",6,7,"27",8,9,10,11,12,14,16,17,18,"24","25",19,20,21,"29"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":30,"NextAnswerId":1,"QuestionID":"QID57","DataVisibility":{"Private":false,"Hidden":false},"RecodeValues":{"1":"1","2":"2","3":"4","4":"6","5":"7","6":"9","7":"10","8":"12","9":"13","10":"14","11":"15","12":"16","14":"17","16":"18","17":"19","18":"20","19":"23","20":"24","21":"25","22":"3","23":"5","24":"21","25":"22","26":"8","27":"11","29":"26"},"QuestionText_Unsafe":"Which of the following is your native language?","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\n\/\/ Pull choices from current question\n\t\nlet targetElement = this.getChoiceContainer();\nlet myChoices = targetElement.children;\nmyChoices = Array.prototype.slice.call(myChoices);\n\t\n\/\/ Sort choices\nmyChoices.sort(function(a, b) {\nreturn a.textContent.localeCompare(b.textContent, '${e:\/\/Field\/Q_Language}', {sensitivity: 'base', ignorePunctuation: true, numeric: true});\n});\n\t\n\/\/ Return choices to current question\nfor (let i=0; i < myChoices.length; i++) {\ntargetElement.appendChild(myChoices[i]);\n}\njQuery(\"#\"+this.questionId+\" select\").find(\"option:eq(0)\")\n    \n    .text(\" \").prop({\"disabled\":true,\"selected\":true});\n});\nQualtrics.SurveyEngine.addOnReady(function()\n{\n    \/*Place your JavaScript here to run when the page is fully displayed*\/\n});\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n    \/*Place your JavaScript here to run when the page is unloaded*\/\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"Suppose that you have $100 in a savings account and the interest rate is 2% per year. After 5 yea...","TertiaryAttribute":null,"Payload":{"QuestionText":"Suppose that you have $100 in a savings account and the interest rate is 2% per year. After 5 years, how much do you think you would have in the account if you let the money grow?","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"fin_lit1","QuestionID":"QID59","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline"},"QuestionDescription":"Suppose that you have $100 in a savings account and the interest rate is 2% per year. After 5 yea...","Choices":{"4":{"Display":"More than $102"},"5":{"Display":"Exactly $102"},"6":{"Display":"Less than $102"},"7":{"Display":"I do not know"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":4,"RecodeValues":{"4":"1","5":"2","6":"3","7":"4"},"QuestionText_Unsafe":"Suppose that you have $100 in a savings account and the interest rate is 2% per year. After 5 years, how much do you think you would have in the account if you let the money grow?"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID60","SecondaryAttribute":"Imagine that the interest rate on your savings account was 1% per year and inflation was 2% per y...","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine that the interest rate on your savings account was 1% per year and inflation was 2% per year. After 1 year,\nhow much would you be able to buy with the money in this account?","DefaultChoices":false,"DataExportTag":"fin_lit2","QuestionID":"QID60","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":274,"InputHeight":29},"QuestionDescription":"Imagine that the interest rate on your savings account was 1% per year and inflation was 2% per y...","Choices":{"4":{"Display":"More than today"},"5":{"Display":"Exactly the same as today"},"6":{"Display":"Less than today"},"7":{"Display":"I do not know"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"RecodeValues":{"4":"1","5":"2","6":"3","7":"4"},"QuestionText_Unsafe":"Imagine that the interest rate on your savings account was 1% per year and inflation was 2% per year. After 1 year,\nhow much would you be able to buy with the money in this account?"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID61","SecondaryAttribute":"Buying a single company's stock usually provides a safer return than a stock mutual fund.","TertiaryAttribute":null,"Payload":{"QuestionText":"Buying a single company's stock usually provides a safer return than a stock mutual fund.","DefaultChoices":false,"DataExportTag":"fin_lit3","QuestionID":"QID61","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Buying a single company's stock usually provides a safer return than a stock mutual fund.","Choices":{"1":{"Display":"True"},"2":{"Display":"False"},"3":{"Display":"I do not know"}},"ChoiceOrder":[1,2,"3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"Buying a single company's stock usually provides a safer return than a stock mutual fund."}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID62","SecondaryAttribute":"If interest rates rise, what would typically happen to bond prices?","TertiaryAttribute":null,"Payload":{"QuestionText":"If interest rates rise, what would typically happen to bond prices?","DefaultChoices":false,"DataExportTag":"fin_lit4","QuestionID":"QID62","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If interest rates rise, what would typically happen to bond prices?","Choices":{"4":{"Display":"They collapse"},"5":{"Display":"They remain unchanged"},"6":{"Display":"There is no relationship"},"7":{"Display":"I do not know"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"RecodeValues":{"4":"1","5":"2","6":"3","7":"4"},"QuestionText_Unsafe":"If interest rates rise, what would typically happen to bond prices?"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID63","SecondaryAttribute":"The survey you have completed aims to replicate the mental accounting effect. According to this p...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\">The survey you have completed aims to replicate the mental accounting effect. According to this phenomenon a person attributes different values to the same amount of money based on subjective criteria. Specifically, people tend to subjectively organize economic resources into different mental accounts. In addition, in this study, we measured some individual differences that might have an influence on mental accounting. In particular:   \t\n \t\n&nbsp;<\/p><p dir=\"ltr\"><br><\/p><p dir=\"ltr\">\u25cf\tScale to measure financial literacy (Lusardi and Mitchell, 2014).  \t \t \t\n&nbsp;<\/p><p dir=\"ltr\">\u25cf\tDemographic data (e.g. gender, age or income level)\t\n\n&nbsp;<\/p><p dir=\"ltr\"><br><\/p><p dir=\"ltr\">Finally, we inform you that we have also used an attentional check to measure respondent engagement. The purpose of this study could not be fully revealed at the beginning of the study to avoid influencing your answers. Now that you have received this information, we ask you to confirm your consent to participate in this study or to withdraw it. In the latter case your data will not be used and will be deleted.\n<br><\/p>","DefaultChoices":false,"DataExportTag":"Debriefing","QuestionID":"QID63","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The survey you have completed aims to replicate the mental accounting effect. According to this p...","Choices":{"1":{"Display":"I allow you to use the responses I provided in this study."},"2":{"Display":"I do NOT allow you to use the responses I provided in this study, and I want them to be deleted."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<p dir=\"ltr\">The survey you have completed aims to replicate the mental accounting effect. According to this phenomenon a person attributes different values to the same amount of money based on subjective criteria. Specifically, people tend to subjectively organize economic resources into different mental accounts. In addition, in this study, we measured some individual differences that might have an influence on mental accounting. In particular:   \t\n \t\n&nbsp;<\/p><p dir=\"ltr\"><br><\/p><p dir=\"ltr\">\u25cf\tScale to measure financial literacy (Lusardi and Mitchell, 2014).  \t \t \t\n&nbsp;<\/p><p dir=\"ltr\">\u25cf\tDemographic data (e.g. gender, age or income level)\t\n\n&nbsp;<\/p><p dir=\"ltr\"><br><\/p><p dir=\"ltr\">Finally, we inform you that we have also used an attentional check to measure respondent engagement. The purpose of this study could not be fully revealed at the beginning of the study to avoid influencing your answers. Now that you have received this information, we ask you to confirm your consent to participate in this study or to withdraw it. In the latter case your data will not be used and will be deleted.\n<br><\/p>"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"You are on the beach on a hot day, and you would really like a cold drink. A friend offers to go...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are on the beach on a hot day, and you would really like a cold drink. A friend offers to go buy the drink from&nbsp;<b>a small, run-down grocery store<\/b>. They ask how much you are willing to pay for the drink: they will only buy it if it costs as much or less than the price you state. You trust your friend, and there is no possibility of bargaining with the store owner.<br>\n<br>\nWhat price do you tell them?","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":61,"InputHeight":29},"QuestionDescription":"You are on the beach on a hot day, and you would really like a cold drink. A friend offers to go...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"You are on the beach on a hot day, and you would really like a cold drink. A friend offers to go buy the drink from&nbsp;<b>a small, run-down grocery store<\/b>. They ask how much you are willing to pay for the drink: they will only buy it if it costs as much or less than the price you state. You trust your friend, and there is no possibility of bargaining with the store owner.<br>\n<br>\nWhat price do you tell them?","DataExportTag":"Drink2","QuestionID":"QID70","Choices":{"4":{"Display":"&nbsp;","TextEntry":"on","InputHeight":29,"InputWidth":61}},"ChoiceOrder":["4"],"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tvar inputs = $(this.getQuestionContainer()).select('input[type=\"text\"]');\n\nfor (var i = 0; i < inputs.length; i++) {\n  var input = inputs[i];\n  $(input).insert({before: '$ '});\n}\n\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID74","SecondaryAttribute":"You are about to purchase a jacket for $15 and a Bluetooth speaker for $125. The salesman informs...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are about to purchase a <strong>jacket<\/strong> for <strong>$15<\/strong> and a <strong>Bluetooth speaker<\/strong> for <strong>$125<\/strong>. The salesman informs you that the <strong>speaker <\/strong>you wish to buy is on sale for <strong>$120<\/strong> at the other branch store, located <strong>20 minutes<\/strong> away.<br \/>\n<br \/>\nWould you make the trip to the other store?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}},"LabelPosition":"BELOW"},"QuestionDescription":"You are about to purchase a jacket for $15 and a Bluetooth speaker for $125. The salesman informs...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"You are about to purchase a <strong>jacket<\/strong> for <strong>$15<\/strong> and a <strong>Bluetooth speaker<\/strong> for <strong>$125<\/strong>. The salesman informs you that the <strong>speaker <\/strong>you wish to buy is on sale for <strong>$120<\/strong> at the other branch store, located <strong>20 minutes<\/strong> away.<br \/>\n<br \/>\nWould you make the trip to the other store?","DataExportTag":"Jacket2","QuestionID":"QID74"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Imagine that you are on your way to a music event and intend to buy a ticket worth $40. On enteri...","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine that you are on your way to a music event and <strong>intend to buy a ticket worth $40<\/strong>. On entering the venue, you realize that <strong>you have lost $40 in cash<\/strong>.<br>\n<br>Would you still pay $40 for a ticket?<br><br>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":true}},"LabelPosition":"BELOW"},"QuestionDescription":"Imagine that you are on your way to a music event and intend to buy a ticket worth $40. On enteri...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Imagine that you are on your way to a music event and <strong>intend to buy a ticket worth $40<\/strong>. On entering the venue, you realize that <strong>you have lost $40 in cash<\/strong>.<br>\n<br>Would you still pay $40 for a ticket?<br><br>","DataExportTag":"Play2 ","QuestionID":"QID78"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Person A was given two tickets to the lottery. They won\u00a0$50\u00a0with one ticket and\u00a0$25\u00a0with the oth","TertiaryAttribute":null,"Payload":{"QuestionText":"<meta charset=\"UTF-8\" \/>Person A was given two tickets to the lottery. They won&nbsp;<b>$50<\/b>&nbsp;with one ticket and&nbsp;<b>$25<\/b>&nbsp;with the other ticket.&nbsp;&nbsp;<br \/>\n<br \/>\nPerson B was given a ticket to one lottery. They won&nbsp;<b>$75.<\/b>&nbsp;&nbsp;\n<div>\n<div>\n<div>&nbsp;<\/div>\n\n<div>Who is happier?<\/div>\n<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"MrAB1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Person A was given two tickets to the lottery. They won\u00a0$50\u00a0with one ticket and\u00a0$25\u00a0with the othe...","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"No difference "}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID8","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<meta charset=\"UTF-8\" \/>Person A was given two tickets to the lottery. They won&nbsp;<b>$50<\/b>&nbsp;with one ticket and&nbsp;<b>$25<\/b>&nbsp;with the other ticket.&nbsp;&nbsp;<br \/>\n<br \/>\nPerson B was given a ticket to one lottery. They won&nbsp;<b>$75.<\/b>&nbsp;&nbsp;\n<div>\n<div>\n<div>&nbsp;<\/div>\n\n<div>Who is happier?<\/div>\n<\/div>\n<\/div>"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"Imagine that you go to the gym on a regular basis. Due to your busy working schedule, you can onl...","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine that you go to the gym on a regular basis. Due to your busy working schedule, you can only go on Monday nights. The membership costs you <strong>$1000<\/strong> a year (i.e., roughly $20 per visit). One Monday, just after you have arrived and changed into your gym clothes, you receive a phone call that requires you to leave and forgo your exercise that evening.<br>\n<br>\nHow well does\r\neach of the following statements capture your feelings about the cost of the missed\r\nworkout?","DefaultChoices":false,"DataExportTag":"Gym2 ","QuestionID":"QID82","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Imagine that you go to the gym on a regular basis. Due to your busy working schedule, you can onl...","Choices":{"1":{"Display":"I feel like I wasted $20"},"2":{"Display":"I feel like I wasted nothing, since my visit had already been paid for"},"3":{"Display":"I feel like I wasted something, but no specific amount or measure comes to mind"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"<div style=\"text-align: center;\">Strongly agree<br \/>\n<br \/>\n1<\/div>\n"},"2":{"Display":"&nbsp;"},"3":{"Display":"&nbsp;"},"4":{"Display":"&nbsp;"},"5":{"Display":"<div style=\"text-align: center;\">Strongly disagree<br \/>\n<br \/>\n5<\/div>\n"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Imagine that you go to the gym on a regular basis. Due to your busy working schedule, you can only go on Monday nights. The membership costs you <strong>$1000<\/strong> a year (i.e., roughly $20 per visit). One Monday, just after you have arrived and changed into your gym clothes, you receive a phone call that requires you to leave and forgo your exercise that evening.<br>\n<br>\nHow well does\r\neach of the following statements capture your feelings about the cost of the missed\r\nworkout?"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"You are flying with a friend who has upgraded their ticket to business class and has two coupons,...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are flying with a friend who has upgraded their ticket to business class and has two coupons, each worth $35, which could be used to upgrade your ticket from economy to business class. They purchased one coupon for the standard price of $35 and received the other one for free. Just one coupon is required to upgrade your class on the current flight and your friend offers you the coupon <b>which they got for free<\/b> so that you can upgrade your ticket as well.<br>\n<br>\nWhat do you think is the most appropriate thing to do?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are flying with a friend who has upgraded their ticket to business class and has two coupons,...","Choices":{"1":{"Display":"Pay your friend $35 for the coupon."},"2":{"Display":"Consider it a gift and not pay for the coupon."},"3":{"Display":"Pay some, but not the full amount for the coupon (for example, half the price)."}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"You are flying with a friend who has upgraded their ticket to business class and has two coupons, each worth $35, which could be used to upgrade your ticket from economy to business class. They purchased one coupon for the standard price of $35 and received the other one for free. Just one coupon is required to upgrade your class on the current flight and your friend offers you the coupon <b>which they got for free<\/b> so that you can upgrade your ticket as well.<br>\n<br>\nWhat do you think is the most appropriate thing to do?","DataExportTag":"Plane2 ","QuestionID":"QID86"}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"Thank you for participating in the study. Below you will be presented with some daily-life scenar...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for participating in the study. Below you will be presented with some daily-life scenarios. <br><br>You will be asked to give your personal opinion about each scenario. Please read them carefully and give your honest answer. There are no right or wrong answers.&nbsp;Note that some scenarios might seem similar to each other but they are not, so please read them carefully.","DefaultChoices":false,"DataExportTag":"Instruction","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for participating in the study. Below you will be presented with some daily-life scenar...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID87","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"Thank you for participating in the study. Below you will be presented with some daily-life scenarios. <br><br>You will be asked to give your personal opinion about each scenario. Please read them carefully and give your honest answer. There are no right or wrong answers.&nbsp;Note that some scenarios might seem similar to each other but they are not, so please read them carefully."}},{"SurveyID":"SV_1yUDCwQabvjZt6m","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}